# PawConnect Environment Configuration Template
FLASK_SECRET_KEY=replace_with_a_secure_random_key
FLASK_DEBUG=True

# MySQL Database Configuration
# Change DB_USER and DB_PASSWORD to match your local MySQL Server credentials
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pawconnect_db

# Set DB_SSL=true when connecting to Cloud MySQL (e.g. TiDB Serverless, Aiven)
# Leave false or omit for local MySQL
DB_SSL=false
